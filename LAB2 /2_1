#include <iostream>

using namespace std;

// Function to generate Fibonacci sequence using iteration (loops)
void generateFibonacciIterative(int n) {
    // Handle edge cases: negative input
    if (n < 0) {
        cout << "Please enter a non-negative integer." << endl;
        return;
    }
    
    // Handle edge case: if n is 0, just print 0
    if (n == 0) {
        cout << "0" << endl;
        return;
    }

    // Use 'long long' to prevent integer overflow for larger values of n
    long long t1 = 0; // First term
    long long t2 = 1; // Second term
    long long nextTerm = 0;

    cout << "Fibonacci Sequence (Iterative): ";
    // Print the first two terms manually
    cout << t1 << ", " << t2;

    // Loop starts from the 3rd term (index 2) up to n
    for (int i = 2; i <= n; ++i) {
        nextTerm = t1 + t2; // Calculate the next term
        cout << ", " << nextTerm;

        // Update variables for the next iteration
        t1 = t2;
        t2 = nextTerm;
    }
    cout << endl; // New line at the end
}

int main() {
    int n;
    cout << "Enter the number of terms (n): ";
    cin >> n;

    generateFibonacciIterative(n);

    return 0;
}
